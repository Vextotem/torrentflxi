# ---- Site ----
SITE_NAME=TorrentFlxi
# Your public address, used for canonical links and the sitemap
SITE_URL=https://torrentflxi.org
# Your player (Torrents / Torrents-Pengu) — every title page embeds PLAYER_URL/embed/...
PLAYER_URL=https://player.yourdomain.com
# Shown on the DMCA page
CONTACT_EMAIL=

# ---- Catalog (TMDB) ----
# Your TMDB v3 API key (the same one Moviepire uses) ...
TMDB_API_KEY=
# ... or a v4 read access token instead
TMDB_READ_TOKEN=
# ... or your own TMDB proxy that adds the key itself (then leave the key empty)
TMDB_BASE_URL=https://api.themoviedb.org/3
# Country for "Where to watch" (JustWatch data)
WATCH_REGION=US

# ---- Torrent search ----
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
INDEXER_MOVIES=YTS
INDEXER_TV=EZTV
INDEXER_ANIME=Nyaa
INDEXER_BACKUP=Knaben,The Pirate Bay,LimeTorrents
# Your Comet manifest link (optional)
COMET_URL=
COMET_TIMEOUT_MS=8000
# Torrent searches per visitor IP per minute (0 = no limit)
TORRENT_RATE_LIMIT=30
MIN_SEEDERS=1

# ---- Subtitles (downloads on title pages) ----
SUBTITLES_ENABLED=true
SUBTITLE_LANGS=en

# ---- Ads: paste your ad tags into ads.js; false = no ads ----
ADS_ENABLED=true
